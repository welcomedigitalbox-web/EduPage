# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Facebook ---
# Page access token (never expiring, from a System User is best)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
# You invent this string; paste the same one into the Meta webhook setup form
FB_VERIFY_TOKEN=
# App secret - used to verify X-Hub-Signature-256 on every webhook call
FB_APP_SECRET=
FB_API_VERSION=v21.0

# --- Meta Marketing API (ads spend sync) ---
META_AD_ACCOUNT_ID=act_1234567890
META_ADS_ACCESS_TOKEN=

# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# --- Cron protection (Vercel Cron sends this automatically) ---
CRON_SECRET=

# --- Dashboard login (simple shared password gate) ---
DASHBOARD_PASSWORD=
